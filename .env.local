# Still needs your real deployed URL — swap "your-domain.com" for your actual
# Vercel domain (e.g. https://apex-duel.vercel.app). This must be a public HTTPS
# URL that Safaricom's servers can reach — localhost will not work, even in dev.
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# NEW - was completely missing from your list, but pages/wallet/deposit.tsx reads
# this to display the Paybill number on the "Pay via Paybill" tab. Without it, the
# deposit page shows the literal placeholder text "YOUR_PAYBILL_NUMBER" to real users.
# This is public-facing (NEXT_PUBLIC_), so it's safe to expose — set it to match
# MPESA_SHORTCODE above (they're normally the same number).
