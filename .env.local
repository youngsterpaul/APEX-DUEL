# NEW - was missing from your list entirely, but pages/api/mpesa/stkpush.ts reads it
# (defaults to sandbox if unset, so the app won't crash without it — but set it
# explicitly so you don't forget to switch it when you go live):
#   sandbox:    https://sandbox.safaricom.co.ke
#   production: https://api.safaricom.co.ke
